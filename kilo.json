{
  "$schema": "https://app.kilo.ai/config.json",
  "compaction": {
    "auto": true,
    "threshold_percent": 75,
    "prune": true,
    "tail_turns": 1,
    "preserve_recent_tokens": 4000,
    "reserved": 18000
  },
  "instructions": ["./AGENTS.md"],
  "skills": {
    "paths": [".kilo/skills"]
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/var/www/html/point-of-sales"],
      "environment": {},
      "enabled": true,
      "timeout": 10000
    }
  }
}
